# Copy this file to .env and fill in your tokens

# Mapbox — get a public token at: https://account.mapbox.com/access-tokens/
MAPBOX_ACCESS_TOKEN=pk.eyJ1...your_token_here

# Google Maps — get an API key at: https://console.cloud.google.com/
# Enable "Maps JavaScript API" for your project
GOOGLE_MAPS_API_KEY=AIza...your_key_here

# TomTom — get a free API key at: https://developer.tomtom.com/
# Free tier: 2,500 map tile requests/day
TOMTOM_API_KEY=your_key_here
